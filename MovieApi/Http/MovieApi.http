@MovieApi_HostAddress = http://localhost:5225
@MovieApi_Controller = api/movies
@movieId = 28

### Get all movies 
GET {{MovieApi_HostAddress}}/{{MovieApi_Controller}}
Accept: application/json

### Get movie X 
GET {{MovieApi_HostAddress}}/{{MovieApi_Controller}}/{{movieId}}
Accept: application/json

### Delete movie X
DELETE {{MovieApi_HostAddress}}/{{MovieApi_Controller}}/{{movieId}}
Accept: application/json

### POST new movie (full)
POST {{MovieApi_HostAddress}}/{{MovieApi_Controller}}/
Content-Type: application/json

{
  "title": "NEW! Tasty Plastic Pants :D",
  "genre": "Rock",
  "director": "Arne Lang",
  "releaseYear": 2008,
  "durationMinutes": 4,
  "rating": 2.9,
  "description": "Carbonite web goalkeeper gloves are ergonomically designed to give easy fit"
}

### PUT movie (update part)
PUT {{MovieApi_HostAddress}}/{{MovieApi_Controller}}/{{movieId}}
Content-Type: application/json

{
  "id": {{movieId}},
  "title": "ALL NEW!! Tasty Plastic Pants - ROFL! :D",
  "genre": "Rock",
  "director": "Arne Lang",
  "releaseYear": 2008,
  "durationMinutes": 4,
  "rating": 2.9,
  "description": "Carbonite web goalkeeper gloves are ergonomically designed to give easy fit"
}